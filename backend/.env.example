# iReader Backend Configuration
PORT=10000
DATA_DIR=~/.ireader/data

# ── 安全（必填，Phase 0 / D6）────────────────────────────
# JWT 签名密钥：启动强校验，缺失或长度 <32 字符将拒绝启动
# 生成命令: openssl rand -hex 32
# 部署环境由 deploy.sh 自动生成并持久化到部署目录 .env（~/.ireader/app/.env）
JWT_SECRET=

# ── TTS Configuration (OpenAI-Compatible) ────────────────
# 未在设置页配置时的默认 TTS 服务（对应 ttsProxyService 的 DEFAULT_API_URL/KEY/MODEL）
# TTS_API_URL=http://127.0.0.1:8883
# TTS_API_KEY=sk-xxx
# TTS_DEFAULT_MODEL=tts-1
TTS_REQUEST_TIMEOUT_MS=30000
# TTS 缓存目录（可选，默认位于 DATA_DIR 下）
# TTS_CACHE_DIR=
