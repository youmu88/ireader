# iReader pnpm configuration
# Ensure devDependencies are always installed (needed for typecheck, testing)
include=dev

# Use pnpm-lock.yaml for reproducible installs
# pnpm 默认使用 lockfile v6.0，与 npm 的 package-lock.json 互斥
lockfile=true

# 避免幽灵依赖（hoisting），保证依赖声明明确
strict-peer-dependencies=false

# 使用 workspace 协议管理 monorepo 依赖
link-workspace-packages=true

# 所有包共享一个 node_modules 层级（提升）
shamefully-hoist=true